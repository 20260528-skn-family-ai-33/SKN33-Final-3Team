# Merge these keys into the repository root .env. Do not commit real credentials.
# Shared by API, worker, scheduler and ML. Switch only after docs/S3_STORAGE.md migration.
ARTIFACT_STORAGE=local
ARTIFACT_S3_BUCKET=
AWS_REGION=ap-northeast-2
ARTIFACT_S3_PREFIX=
ARTIFACT_CACHE_DIRECTORY=runtime/s3-cache
ARTIFACT_MODEL_CHECK_SECONDS=30
API_DB_TARGET=rds
RDS_MYSQL_HOST=your-rds-hostname
RDS_MYSQL_PORT=3306
RDS_MYSQL_DATABASE=trade_agent
RDS_MYSQL_USER=your-app-user
RDS_MYSQL_PASSWORD=
RDS_MYSQL_SSL_CA=C:/path/to/rds-ca.pem
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS production must use true. Set false only for local HTTP development.
API_COOKIE_SECURE=true
API_SESSION_HOURS=12
# 인증 세션·요청 제한(api/redis_store.py)과 채팅 에이전트가 같이 쓴다. 비밀번호는 deploy/redis/redis-auth.conf와 같게 둔다(docs/AGENT_DESIGN.md D-01·D-07).
API_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
API_REDIS_PREFIX=borderless:dev:
API_REPORT_DIRECTORY=runtime/reports
# Immediate retry once per round; then wait before a new round.
API_REPORT_RETRY_DELAY_SECONDS=300
API_REPORT_MAX_ATTEMPTS=3
# Required article sources for weekly publication (not all enabled SOURCE options).
# Add KOTRA sources only when their daily loads are operated and monitored.
API_WEEKLY_NEWS_SOURCES=HANKYUNG,FNNEWS
# Maximum eligible candidates per table, after status/time filtering (not history rows).
API_JOB_SCAN_SIZE=100
# 병렬 워커(D-105) 동시 스레드 상한. 임시값(C-33). DB 접속 풀은 스레드 수 × 2 + 2
API_WORKER_MAX_THREADS=16
# 주인 없는 에이전트 작업의 유예 시간(초, D-106). 임시값(C-32)
API_AGENT_ADOPT_GRACE_SECONDS=600
# ML 전용 스레드 줄을 기다리는 상한(초). 예측 시간 상한과 따로 센다. 임시값(C-34)
API_ML_QUEUE_SECONDS=60
# Trust only the real reverse proxy addresses; leave empty for direct connections.
# Run uvicorn with --no-proxy-headers so the app can verify the socket peer itself.
API_TRUSTED_PROXY_CIDRS=
API_AUTH_IP_LIMIT=100
API_AUTH_EMAIL_LIMIT=10
# API-130: 메일 실패·가입 정보 불일치도 횟수에 포함. 최근 24시간의 이동 창 기준.
API_RECOVERY_COOLDOWN_SECONDS=600
API_RECOVERY_DAILY_MAX=5
# 임시 비밀번호 메일. SSL(465) 또는 STARTTLS(587) 사용; 실제 자격정보는 커밋하지 않는다.
API_SMTP_HOST=smtp.gmail.com
API_SMTP_PORT=587
API_SMTP_SECURITY=starttls
API_SMTP_FROM=
API_SMTP_USERNAME=
API_SMTP_PASSWORD=
API_SMTP_TIMEOUT_SECONDS=10
# DNS·TLS·인증·전송 전체 상한(최대 15초). 초과하면 발송 프로세스를 종료한다.
API_SMTP_TOTAL_TIMEOUT_SECONDS=15
API_HS_VECTOR_ENABLED=true
API_HS_CHROMA_PATH=chroma_data
API_HS_MAX_DISTANCE=0.70
API_HS_CONFIDENT_DISTANCE=0.45
API_HS_MIN_MARGIN=0.08
API_HS_TIMEOUT_SECONDS=3
API_HS_IP_LIMIT=60
# Increase after a reference/vector rebuild; per-process bounded caches expire in 300s.
API_HS_CACHE_VERSION=1
# One structured slot extraction call per chat job; no automatic retry.
API_INTENT_MODEL=gpt-4.1-mini
API_INTENT_TIMEOUT_SECONDS=10
# Agent worker recovery limit per round (D-85); future worker integration.
API_CHAT_MAX_RECOVERIES=2
# 채팅 에이전트 compose·LLM SQL·ML (docs/AGENT_DESIGN.md §13.3). 아직 코드에서 읽지 않는다.
API_COMPOSE_MODEL=gpt-4.1-mini
# 새 질문을 LangGraph 워커로 접수한다. 기존 미완료 작업은 원래 실행기로 마친다.
API_CHAT_AGENT_ENABLED=true
API_COMPOSE_TIMEOUT_SECONDS=20
API_SQL_MODEL=gpt-4.1
API_SQL_TIMEOUT_SECONDS=20
API_SQL_EXECUTION_SECONDS=30
# 월별 READY 레지스트리의 artifact_path가 가리키는 앙상블 번들. 특정 파일 고정 시 PATHS에 지정한다.
API_ML_MODEL_DIRECTORY=data/ml/monthly_models
API_ML_MODEL_PATHS=
# 증감 예상(모델 B) 파일. 비우면 API_ML_MODEL_DIRECTORY의 가장 최근 model_b_growth_<YYYYMM>.joblib을 쓰고, 없으면 방향 없이 답한다
API_ML_GROWTH_MODEL_PATH=
# Required for query embeddings; share the ingestion model and collection.
OPENAI_API_KEY=
API_REPORT_FONT=C:/Windows/Fonts/malgun.ttf
API_DEBUG_SQL=false
