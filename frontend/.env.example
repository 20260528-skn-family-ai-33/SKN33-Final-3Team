# 소셜 로그인 설정 — 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. (.env는 Git에 올리지 않습니다)
# 각 콘솔에 등록할 Redirect(Callback) URI
#   카카오 http://localhost:5173/oauth/kakao
#   네이버 http://localhost:5173/oauth/naver
#   구글   http://localhost:5173/oauth/google

# 카카오 Developers → 내 애플리케이션 → 앱 키 → REST API 키
VITE_KAKAO_REST_API_KEY=
# 카카오 로그인 → 보안 → Client Secret을 "사용함"으로 켰을 때만 입력
KAKAO_CLIENT_SECRET=

# 네이버 Developers → 애플리케이션 → Client ID / Client Secret
VITE_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 백엔드(FastAPI 등)가 토큰 교환을 맡게 되면 그 주소를 넣으세요. 비워 두면 개발 서버(/api)가 처리합니다.
# 예) VITE_AUTH_API_BASE=http://localhost:8000/api
VITE_AUTH_API_BASE=
# 배포 주소가 다르면 콜백 주소의 기준 origin (비우면 현재 주소)
VITE_OAUTH_REDIRECT_ORIGIN=
