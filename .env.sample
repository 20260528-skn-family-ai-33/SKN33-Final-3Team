# 실제 인증값은 .env에만 입력하고 커밋하지 마세요.
# 해외시장뉴스 API
news=YOUR_NEWS_API_KEY
# 단신속보뉴스 API
shortnews=YOUR_SHORTNEWS_API_KEY

# MySQL 적재 설정 (적재 기능을 사용할 때만 설정)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=news_db
# RDS 등 인증서 검증이 필요한 연결에서만 지정. 상대 경로는 이 파일 기준입니다.
MYSQL_SSL_CA=
# 사용법: 이 파일을 복사해 저장소 루트에 .env로 만들고 값을 바꿉니다.

# 관세청 품목별 국가별 수출입실적 API (customs_collect.py)
# 발급: 공공데이터포털(data.go.kr) 로그인 → "관세청_품목별 국가별 수출입실적(GW)" 검색 → 활용신청
#       → 마이페이지 > 데이터활용 > Open API > 활용신청 현황에서 일반 인증키 복사 (Encoding·Decoding 어느 것이든 가능)
# 키 이름은 대소문자 구분 없음 (customs, CUSTOMS 모두 가능)
customs=YOUR_CUSTOMS_API_KEY

# 수출입 월별 자동 복구 시작 월 (실제 운영 범위에 맞게 변경)
CUSTOMS_START_MONTH=202601

# 수출입 월별 작업(매월 10일 03:00 KST)의 마지막 ML 단계: 최종 모델 전체 재학습 → data/ml/monthly_models/two_stage_<YYYYMM>.joblib
# 비우면 적재·계산까지만 하고 WAITING_FOR_ML 상태로 멈춘다
CUSTOMS_ML_ENTRYPOINT=backend.app.ml.candidate_models:run

# HS 코드 마스터 6단위 품목명 요약 (hs_code_build.py)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# 한국은행 ECOS Open API 환율 (ecos_collect.py, fx_daily_load.py)
# 발급: ECOS Open API(https://ecos.bok.or.kr/api/) 로그인 → 인증키 신청. 키 이름은 ECOS_API_KEY 또는 ecos (대소문자 구분 없음)
ECOS_API_KEY=YOUR_ECOS_API_KEY

# 환율 최초 적재 시작 날짜 (YYYY-MM-DD): 통화에 환율이 한 건도 없을 때 이 날짜부터 받음. 비우면 최근 14일만 받음
FX_START_DATE=2026-01-01

# UN 데이터 적재 설정
UN_COMTRADE_API_KEY=YOUR_UN_API_KEY

# 공용 스케줄러의 단신 정기·시작 복구. 독립 worker에는 적용하지 않습니다.
SHORTNEWS_DAILY_ENABLED=false
